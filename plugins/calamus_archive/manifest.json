{
  "id": "ksnxdev.calamus_archive",
  "name": "Private View",
  "version": "1.1.0",
  "description": "Локальный архив полученных сообщений и правок, история из меню сообщения и управление собственным онлайн-статусом. До 16 МиБ / 20000 версий. Требуется Calamus 71360+ и Android 10+.",
  "author": "ksnxdev",
  "api_version": 3,
  "permissions": [
    "storage",
    "notifications",
    "commands",
    "accounts.read",
    "messages.read",
    "messages.archive",
    "messages.menu",
    "ui",
    "presence.control",
    "presence.read"
  ],
  "required_permissions": [
    "storage",
    "commands",
    "accounts.read",
    "messages.read",
    "messages.archive",
    "messages.menu",
    "ui"
  ],
  "events": [
    "app.foreground",
    "account.changed",
    "message.received",
    "message.updated",
    "message.sent",
    "message.deleted",
    "message.action",
    "settings.changed"
  ],
  "settings": [
    {
      "key": "capture",
      "title": "Сохранять новые сообщения и правки",
      "type": "boolean",
      "default": true
    },
    {
      "key": "ghost",
      "title": "Режим призрака для выбранных аккаунтов",
      "type": "boolean",
      "default": false
    }
  ]
}

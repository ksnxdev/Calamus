{
  "id": "ksnxdev.hello",
  "name": "Hello Calamus",
  "version": "2.1.0",
  "description": "Local greeting and optional chat commands with explicit permissions.",
  "author": "ksnxdev",
  "api_version": 2,
  "permissions": [
    "storage",
    "notifications",
    "accounts.read",
    "chats.read",
    "messages.read",
    "messages.send",
    "ui",
    "commands"
  ],
  "events": [
    "app.started",
    "app.foreground",
    "chat.opened",
    "settings.changed"
  ],
  "settings": [
    {
      "key": "greeting",
      "title": "Greeting text",
      "type": "string",
      "default": "Hello from Calamus!"
    },
    {
      "key": "include_name",
      "title": "Include account name",
      "type": "boolean",
      "default": true
    }
  ],
  "required_permissions": [
    "storage",
    "commands"
  ]
}
